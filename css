<style>
    :root {
      color-scheme: light;
      --paper: #f3f5ef;
      --white: #fffefa;
      --ink: #202b25;
      --muted: #68756c;
      --line: #dce2d8;
      --green: #2e5745;
      --green-dark: #203d32;
      --lime: #d9e779;
      --coral: #e77f63;
      --serif: "Playfair Display", Georgia, serif;
      --sans: "DM Sans", sans-serif;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      color: var(--ink);
      background: var(--paper);
      font: 15px/1.5 var(--sans);
    }
    button, input, textarea { font: inherit; }
    button { color: inherit; }
    a { color: inherit; text-decoration: none; }
    img { display: block; width: 100%; }
    .wrap { width: min(1120px, calc(100% - 48px)); margin-inline: auto; }

    .topline {
      display: flex;
      justify-content: center;
      gap: 8px;
      padding: 9px 16px;
      background: var(--green-dark);
      color: #f4f4e8;
      font-size: 11px;
      letter-spacing: .04em;
    }
    .topline span { color: var(--lime); }
    header {
      height: 74px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--line);
    }
    .brand { display: flex; align-items: center; gap: 11px; font-size: 14px; font-weight: 700; letter-spacing: .08em; }
    .brand-mark { width: 30px; height: 30px; display: grid; place-items: center; background: var(--coral); color: var(--white); border-radius: 50%; font: 19px var(--serif); }
    nav { display: flex; gap: 32px; color: #4d5a51; font-size: 13px; }
    nav a:hover { color: var(--green); }
    .nav-book, .primary-button {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      gap: 10px;
      border: 0;
      background: var(--green);
      color: white;
      min-height: 46px;
      padding: 0 21px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: background .2s, transform .2s;
    }
    .nav-book:hover, .primary-button:hover { background: var(--green-dark); transform: translateY(-1px); }

    .hero {
      display: grid;
      grid-template-columns: 1fr 1.04fr;
      align-items: center;
      gap: 7.5%;
      padding-block: 55px 69px;
      min-height: 500px;
    }
    .eyebrow { display: flex; align-items: center; gap: 9px; color: var(--green); font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
    .eyebrow::before { content: ""; width: 19px; height: 1px; background: var(--coral); }
    h1, h2, h3, p { margin-top: 0; }
    h1 {
      max-width: 470px;
      margin: 18px 0 17px;
      font: 500 55px/.99 var(--serif);
      letter-spacing: 0;
    }
    h1 em { color: var(--green); font-weight: 500; }
    .hero-copy { max-width: 390px; margin-bottom: 27px; color: var(--muted); font-size: 15px; line-height: 1.75; }
    .hero-action { display: flex; align-items: center; gap: 17px; }
    .text-link { color: var(--green); font-size: 13px; font-weight: 600; }
    .text-link:hover { text-decoration: underline; text-underline-offset: 4px; }
    .hero-meta { display: flex; align-items: center; gap: 11px; margin-top: 36px; color: var(--muted); font-size: 11px; }
    .avatar-stack { display: flex; padding-left: 5px; }
    .avatar-stack img { width: 27px; height: 27px; object-fit: cover; border: 2px solid var(--paper); border-radius: 50%; margin-left: -5px; }
    .hero-image { position: relative; height: 390px; overflow: hidden; background: #d9ded2; }
    .hero-image img { height: 100%; object-fit: cover; object-position: center 54%; }
    .image-caption { position: absolute; right: 15px; bottom: 15px; padding: 10px 13px; background: var(--white); font-size: 11px; }
    .image-caption strong { display: block; font-size: 12px; }

    .ticker { border-block: 1px solid var(--line); padding: 13px 0; }
    .ticker-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; color: var(--muted); font-size: 11px; }
    .ticker-item { display: flex; align-items: center; gap: 8px; white-space: nowrap; }
    .ticker-item b { color: var(--coral); font-size: 14px; }

    .section { padding-block: 78px; }
    .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 27px; }
    .section-heading h2 { margin: 9px 0 0; font: 500 37px/1.1 var(--serif); }
    .section-heading p { max-width: 300px; margin: 0; color: var(--muted); font-size: 13px; }
    .services { display: grid; grid-template-columns: repeat(3, 1fr); gap: 17px; }
    .service-card { background: var(--white); border: 1px solid var(--line); }
    .service-photo { position: relative; height: 180px; overflow: hidden; background: #dce2d8; }
    .service-photo img { height: 100%; object-fit: cover; transition: transform .45s; }
    .service-card:hover .service-photo img { transform: scale(1.035); }
    .service-index { position: absolute; top: 12px; left: 12px; display: grid; place-items: center; width: 29px; height: 29px; border-radius: 50%; background: var(--paper); font-size: 11px; }
    .service-body { padding: 17px 18px 18px; }
    .service-title-row { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
    .service-title-row h3 { margin: 0; font: 500 20px var(--serif); }
    .service-price { font-size: 13px; font-weight: 700; }
    .service-body p { min-height: 42px; margin: 9px 0 16px; color: var(--muted); font-size: 12px; line-height: 1.65; }
    .service-footer { display: flex; align-items: center; justify-content: space-between; padding-top: 12px; border-top: 1px solid var(--line); }
    .duration { color: var(--muted); font-size: 11px; }
    .choose-service { border: 0; padding: 5px 0 5px 8px; background: transparent; color: var(--green); font-size: 12px; font-weight: 700; cursor: pointer; }
    .choose-service:hover { color: var(--coral); }

    .booking-band { padding-block: 75px; background: #e7ece3; }
    .booking-layout { display: grid; grid-template-columns: .8fr 1.2fr; gap: 8%; align-items: start; }
    .booking-intro { position: sticky; top: 25px; padding-top: 16px; }
    .booking-intro h2 { max-width: 340px; margin: 11px 0 14px; font: 500 39px/1.08 var(--serif); }
    .booking-intro > p { max-width: 330px; margin-bottom: 24px; color: var(--muted); font-size: 13px; line-height: 1.7; }
    .contact-line { display: flex; align-items: center; gap: 10px; color: var(--green); font-size: 12px; font-weight: 600; }
    .contact-dot { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--lime); }
    .booking-form { padding: 26px; background: var(--white); border: 1px solid var(--line); }
    .form-heading { display: flex; align-items: start; justify-content: space-between; gap: 12px; margin-bottom: 22px; }
    .form-heading h3 { margin: 0; font: 500 22px var(--serif); }
    .step-label { padding: 5px 8px; background: #edf1e8; color: var(--green); font-size: 10px; font-weight: 700; }
    .field-label { display: block; margin-bottom: 8px; font-size: 11px; font-weight: 700; }
    .service-select { width: 100%; height: 43px; margin-bottom: 20px; padding: 0 11px; border: 1px solid var(--line); border-radius: 0; background: var(--white); color: var(--ink); font-size: 12px; }
    .date-list { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; margin-bottom: 20px; }
    .date-option { min-height: 57px; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 2px; border: 1px solid var(--line); background: var(--white); cursor: pointer; }
    .date-option span:first-child { color: var(--muted); font-size: 10px; }
    .date-option span:last-child { font-size: 13px; font-weight: 700; }
    .date-option[aria-pressed="true"] { border-color: var(--green); background: var(--green); color: white; }
    .date-option[aria-pressed="true"] span:first-child { color: #dce8df; }
    .time-list { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 20px; }
    .time-option { min-height: 37px; border: 1px solid var(--line); background: var(--white); font-size: 11px; cursor: pointer; }
    .time-option:hover, .time-option[aria-pressed="true"] { border-color: var(--green); color: var(--green); box-shadow: inset 0 0 0 1px var(--green); }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .form-field { min-width: 0; margin-bottom: 14px; }
    .form-field input { width: 100%; height: 41px; padding: 0 10px; border: 1px solid var(--line); border-radius: 0; background: var(--white); font-size: 12px; }
    .form-field input:focus, .service-select:focus { outline: 2px solid #9cac75; outline-offset: 1px; }
    .submit-row { display: flex; align-items: center; justify-content: space-between; gap: 15px; margin-top: 2px; }
    .submit-row .primary-button { min-width: 160px; }
    .secure-note { color: var(--muted); font-size: 10px; }
    .form-error { display: none; margin: 12px 0 0; color: #a63e2c; font-size: 12px; }
    .form-error.visible { display: block; }

    .visit-strip { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 25px; padding-block: 35px; border-bottom: 1px solid var(--line); }
    .visit-item { display: flex; align-items: start; gap: 12px; }
    .visit-icon { display: grid; flex: 0 0 32px; place-items: center; width: 32px; height: 32px; background: var(--lime); color: var(--green-dark); font-size: 13px; }
    .visit-item strong { display: block; margin: 1px 0 3px; font-size: 12px; }
    .visit-item span { display: block; color: var(--muted); font-size: 11px; }
    footer { display: flex; align-items: center; justify-content: space-between; padding-block: 23px; color: var(--muted); font-size: 10px; }
    .footer-links { display: flex; gap: 19px; }
    .footer-links a:hover { color: var(--green); }

    .dialog-backdrop { position: fixed; inset: 0; z-index: 5; display: none; place-items: center; padding: 20px; background: rgb(25 37 29 / 56%); }
    .dialog-backdrop.open { display: grid; }
    .dialog { position: relative; width: min(440px, 100%); padding: 35px; background: var(--white); text-align: center; animation: appear .24s ease-out; }
    .dialog-close { position: absolute; top: 12px; right: 12px; width: 34px; height: 34px; border: 1px solid var(--line); background: transparent; font-size: 18px; cursor: pointer; }
    .dialog-mark { display: grid; width: 47px; height: 47px; margin: 0 auto 15px; place-items: center; border-radius: 50%; background: var(--lime); color: var(--green); font-size: 22px; }
    .dialog h2 { margin-bottom: 9px; font: 500 30px var(--serif); }
    .dialog p { color: var(--muted); font-size: 13px; }
    .confirmation-details { margin: 19px 0; padding: 13px; background: #edf1e8; font-size: 12px; line-height: 1.8; }
    .demo-note { margin: 0 0 18px; color: #8a5b3e !important; font-size: 11px !important; }
    @keyframes appear { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; } }
    @media (max-width: 760px) {
      .hero { gap: 28px; min-height: 0; padding-block: 43px 50px; }
      h1 { font-size: 46px; }
      .hero-image { height: 330px; }
      nav { gap: 15px; }
      .services { gap: 10px; }
      .service-photo { height: 145px; }
      .service-body { padding: 14px; }
      .service-title-row h3 { font-size: 17px; }
      .booking-layout { gap: 5%; }
      .booking-form { padding: 20px; }
      .ticker-inner { overflow-x: auto; justify-content: flex-start; }
    }
    @media (max-width: 560px) {
      .wrap { width: min(100% - 32px, 440px); }
      .topline { font-size: 10px; }
      header { height: 63px; }
      nav { display: none; }
      .nav-book { min-height: 39px; padding-inline: 13px; font-size: 11px; }
      .hero { grid-template-columns: 1fr; gap: 25px; padding-block: 36px 39px; }
      h1 { max-width: 360px; font-size: 45px; }
      .hero-copy { max-width: 350px; font-size: 14px; }
      .hero-meta { margin-top: 23px; }
      .hero-image { height: 275px; }
      .ticker-item { font-size: 10px; }
      .section { padding-block: 54px; }
      .section-heading { display: block; margin-bottom: 20px; }
      .section-heading h2 { font-size: 32px; }
      .section-heading p { margin-top: 10px; }
      .services { grid-template-columns: 1fr; gap: 13px; }
      .service-card { display: grid; grid-template-columns: 112px 1fr; }
      .service-photo { height: 100%; min-height: 155px; }
      .service-body { padding: 13px; }
      .service-body p { min-height: 0; margin: 7px 0 12px; font-size: 11px; }
      .service-title-row h3 { font-size: 18px; }
      .booking-band { padding-block: 52px; }
      .booking-layout { grid-template-columns: 1fr; gap: 24px; }
      .booking-intro { position: static; padding: 0; }
      .booking-intro h2 { font-size: 34px; }
      .booking-form { padding: 17px 14px; }
      .time-list { grid-template-columns: repeat(3, 1fr); }
      .date-list { gap: 5px; }
      .date-option { min-height: 53px; }
      .form-grid { gap: 9px; }
      .submit-row { align-items: start; flex-direction: column; }
      .submit-row .primary-button { width: 100%; }
      .visit-strip { grid-template-columns: 1fr; gap: 17px; padding-block: 26px; }
      footer { align-items: start; gap: 12px; flex-direction: column; }
      .dialog { padding: 32px 22px 24px; }
    }
  </style>